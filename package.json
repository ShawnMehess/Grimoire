{
  "name": "dnd-character-sheet",
  "version": "1.0.0",
  "description": "Vanilla JS D&D character sheet builder",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.mjs",
    "test:smoke": "node --test scripts/smoke-imports.mjs scripts/smoke-dom.mjs",
    "test:imports": "node --test scripts/check-imports.mjs",
    "test:content": "node scripts/verify-content.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:crawl": "node scripts/crawl.mjs",
    "verify": "node scripts/verify-content.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}